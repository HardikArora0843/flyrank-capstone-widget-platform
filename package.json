{
  "name": "flyrank-capstone-widget-platform",
  "version": "1.0.0",
  "description": "Multi-tenant embeddable widget and lead-capture platform with resilient backend ingestion",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "serve:customer": "node scripts/serveCustomerSite.js"
  },
  "keywords": [
    "widget",
    "lead-capture",
    "multi-tenant",
    "cors",
    "rate-limiting",
    "geo-enrichment",
    "resilience"
  ],
  "author": "Hardik Arora",
  "license": "MIT",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "uuid": "^10.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
