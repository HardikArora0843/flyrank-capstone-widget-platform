# Server Configuration
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/widget_platform
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=widget_platform

# Authentication Secrets
JWT_SECRET=super_secret_capstone_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Configuration
# Comma-separated allowed origins for admin or custom rules, or default handling
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=30
RATE_LIMIT_MAX_PER_WIDGET=60

# Geo Provider Settings & Timeouts (in milliseconds)
GEO_PROVIDER_A_TIMEOUT_MS=1500
GEO_PROVIDER_B_TIMEOUT_MS=1500
GEO_PROVIDER_A_URL=http://ip-api.com/json
GEO_PROVIDER_B_URL=https://ipapi.co

# Notification / Email Side Effect
EMAIL_MODE=console # options: console, mailpit, webhook
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

# Background Job Worker
JOB_POLL_INTERVAL_MS=3000
JOB_MAX_ATTEMPTS=3
